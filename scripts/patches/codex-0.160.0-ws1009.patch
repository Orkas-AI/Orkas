+use anyhow::Result;
+use codex_core::TurnInputRequest;
+use codex_model_provider_info::WireApi;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_response_created;
+use core_test_support::responses::mount_sse_once;
+use core_test_support::responses::mount_sse_sequence;
+use core_test_support::responses::sse;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use wiremock::Mock;
+use wiremock::ResponseTemplate;
+use wiremock::http::Method;
+use wiremock::matchers::method;
+use wiremock::matchers::path_regex;
+
+/// Keep WebSocket and HTTP on the same endpoint, forwarding POSTs to the
+/// existing HTTP mock so its parser and captured request oracle remain shared.
+struct SizeRejectingEndpoint {
+    uri: String,
+    frames: std::sync::Arc<std::sync::Mutex<Vec<serde_json::Value>>>,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for SizeRejectingEndpoint {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+#[derive(Clone, Copy)]
+enum SizeRejection {
+    Warmup,
+    Generation,
+}
+
+async fn size_rejecting_endpoint(
+    http_address: std::net::SocketAddr,
+    rejection: SizeRejection,
+) -> SizeRejectingEndpoint {
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio::net::TcpListener;
+    use tokio::net::TcpStream;
+    use tokio_tungstenite::tungstenite::Message;
+    use tokio_tungstenite::tungstenite::protocol::CloseFrame;
+    use tokio_tungstenite::tungstenite::protocol::frame::coding::CloseCode;
+
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let uri = format!("http://{}/v1", listener.local_addr().expect("address"));
+    let frames = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+    let captured = std::sync::Arc::clone(&frames);
+    let task = tokio::spawn(async move {
+        let mut connections = tokio::task::JoinSet::new();
+        loop {
+            let (mut socket, _) = listener.accept().await.expect("accept");
+            let frames = std::sync::Arc::clone(&captured);
+            connections.spawn(async move {
+                // A single-byte peek is sufficient and cannot misclassify a partial method.
+                let mut method = [0; 1];
+                socket.peek(&mut method).await.expect("method");
+                if &method != b"G" {
+                    let mut upstream = TcpStream::connect(http_address).await.expect("HTTP mock");
+                    let _ = tokio::io::copy_bidirectional(&mut socket, &mut upstream).await;
+                    return;
+                }
+                let mut config = tokio_tungstenite::tungstenite::protocol::WebSocketConfig::default();
+                config.extensions.permessage_deflate = Some(
+                    tokio_tungstenite::tungstenite::extensions::compression::deflate::DeflateConfig::default());
+                let mut socket = tokio_tungstenite::accept_async_with_config(socket, Some(config)).await.expect("upgrade");
+                while let Some(Ok(message)) = socket.next().await {
+                    let Message::Text(text) = message else { continue; };
+                    let request: serde_json::Value = serde_json::from_str(&text).expect("request JSON");
+                    frames.lock().expect("frames").push(request.clone());
+                    if request["generate"] == false && matches!(rejection, SizeRejection::Generation) {
+                        for event in [ev_response_created("warm"), ev_completed("warm")] {
+                            socket.send(Message::Text(event.to_string().into())).await.expect("warmup");
+                        }
+                    } else {
+                        socket.close(Some(CloseFrame { code: CloseCode::Size,
+                            reason: "private peer diagnostic must not be displayed".into() })).await.expect("size rejection");
+                        break;
+                    }
+                }
+            });
+            while connections.try_join_next().is_some() {}
+        }
+    });
+    SizeRejectingEndpoint { uri, frames, task }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn websocket_size_rejection_falls_back_once_with_unchanged_image_context() -> Result<()> {
+    use codex_features::Feature;
+    use codex_protocol::models::ImageReference;
+    use core_test_support::wait_for_event;
+
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let endpoint = size_rejecting_endpoint(*server.address(), SizeRejection::Generation).await;
+    let response_mock = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![ev_response_created("first"), ev_completed("first")]),
+            sse(vec![ev_response_created("second"), ev_completed("second")]),
+        ],
+    )
+    .await;
+    let base_url = endpoint.uri.clone();
+    let test = test_codex()
+        .with_config(move |config| {
+            config.model_provider.base_url = Some(base_url);
+            config.model_provider.wire_api = WireApi::Responses;
+            config.model_provider.supports_websockets = true;
+            config.model_provider.stream_max_retries = Some(2);
+            config.model_provider.request_max_retries = Some(0);
+            config
+                .features
+                .disable(Feature::EnableRequestCompression)
+                .expect("compression setting");
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let image_url = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=";
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![
+            UserInput::Text {
+                text: "Inspect this image without changing it".into(),
+                text_elements: Vec::new(),
+            },
+            UserInput::Image {
+                image: ImageReference::Inline {
+                    image_url: image_url.to_string(),
+                },
+                detail: None,
+            },
+        ]))
+        .await?;
+    let warnings = std::sync::Mutex::new(Vec::new());
+    wait_for_event(&test.codex, |event| {
+        if let EventMsg::Warning(warning) = event {
+            warnings
+                .lock()
+                .expect("warnings")
+                .push(warning.message.clone());
+        }
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    insta::assert_snapshot!(serde_json::to_string_pretty(&warnings.into_inner().expect("warnings"))?, @r#"
+    [
+      "Falling back from WebSockets to HTTPS transport. WebSocket request rejected as too large (close 1009)"
+    ]
+    "#);
+    test.submit_text_turn("Continue in the same conversation")
+        .await?;
+
+    let frames = endpoint.frames.lock().expect("frames").clone();
+    let attempts: Vec<_> = frames
+        .iter()
+        .filter(|frame| frame["generate"] != false)
+        .collect();
+    assert_eq!(
+        attempts.len(),
+        1,
+        "1009 must not retry the same WebSocket request"
+    );
+    let posts = response_mock.requests();
+    assert_eq!(
+        posts.len(),
+        2,
+        "HTTP fallback must remain sticky in the same thread"
+    );
+    let rejected = attempts[0];
+    let full_input = if rejected["previous_response_id"].is_string() {
+        let mut input = frames
+            .iter()
+            .find(|frame| frame["generate"] == false)
+            .expect("warmup before continuation")["input"]
+            .as_array()
+            .expect("warmup input")
+            .clone();
+        input.extend(
+            rejected["input"]
+                .as_array()
+                .expect("continuation input")
+                .clone(),
+        );
+        serde_json::Value::Array(input)
+    } else {
+        rejected["input"].clone()
+    };
+    assert_eq!(
+        posts[0].body_json()["input"],
+        full_input,
+        "fallback must preserve all context"
+    );
+    let body = posts[0].body_json();
+    assert!(
+        body["input"]
+            .as_array()
+            .expect("HTTP input")
+            .iter()
+            .any(|item| item["content"]
+                .as_array()
+                .is_some_and(|content| content.iter().any(|part| part["image_url"] == image_url)))
+    );
+    test.codex.shutdown_and_wait().await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn websocket_size_rejection_does_not_loop_when_http_also_rejects() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let endpoint = size_rejecting_endpoint(*server.address(), SizeRejection::Generation).await;
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses$"))
+        .respond_with(ResponseTemplate::new(413).set_body_json(serde_json::json!({
+            "error": { "message": "request too large", "type": "invalid_request_error" }
+        })))
+        .mount(&server)
+        .await;
+    let base_url = endpoint.uri.clone();
+    let test = test_codex()
+        .with_config(move |config| {
+            config.model_provider.base_url = Some(base_url);
+            config.model_provider.wire_api = WireApi::Responses;
+            config.model_provider.supports_websockets = true;
+            config.model_provider.stream_max_retries = Some(2);
+            config.model_provider.request_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Keep the task intact if both transports reject it")
+        .await?;
+    let frames = endpoint.frames.lock().expect("frames").clone();
+    assert_eq!(
+        frames
+            .iter()
+            .filter(|frame| frame["generate"] != false)
+            .count(),
+        1
+    );
+    let posts = server.received_requests().await.unwrap_or_default();
+    assert_eq!(
+        posts
+            .iter()
+            .filter(|request| request.method == Method::POST)
+            .count(),
+        3,
+        "HTTP retains the existing stream retry budget; it must never switch back to WebSocket"
+    );
+    test.codex.shutdown_and_wait().await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn websocket_size_rejection_during_warmup_uses_http_for_generation() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let endpoint = size_rejecting_endpoint(*server.address(), SizeRejection::Warmup).await;
+    let response_mock = mount_sse_once(
+        &server,
+        sse(vec![ev_response_created("http"), ev_completed("http")]),
+    )
+    .await;
+    let base_url = endpoint.uri.clone();
+    let test = test_codex()
+        .with_config(move |config| {
+            config.model_provider.base_url = Some(base_url);
+            config.model_provider.wire_api = WireApi::Responses;
+            config.model_provider.supports_websockets = true;
+            config.model_provider.stream_max_retries = Some(2);
+            config.model_provider.request_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Preserve the task when warmup is rejected")
+        .await?;
+    let frames = endpoint.frames.lock().expect("frames").clone();
+    assert_eq!(
+        frames.len(),
+        1,
+        "warmup rejection must make generation use HTTP directly"
+    );
+    assert_eq!(frames[0]["generate"], false);
+    assert_eq!(response_mock.requests().len(), 1);
+    test.codex.shutdown_and_wait().await?;
+    Ok(())
+}
