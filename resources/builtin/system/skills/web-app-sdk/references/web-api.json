    {
      "name": "data.insert",
      "capability": "data",
      "description": "Insert declared fields, apply defaults and meter canonical UTF-8 bytes atomically. requestId deduplicates the latest 2048 insert requests across reopening.",
      "appTypes": [
        "local",
        "web"
      ],
      "environments": [
        "desktop",
        "preview",
        "online"
      ],
      "status": "supported",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        },
        "required": [
          "table",
          "values"
        ],
        "additionalProperties": false
      },
      "result": "{id:string}; generated record ID, never the private row.",
      "example": {
        "table": "messages",
        "values": {
          "body": "Hello"
        },
        "requestId": "message-1"
      }
